# Runtime selection
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true

# PostgreSQL timestamps are stored in UTC.
DATABASE_URL=postgresql://growthsathi:growthsathi@localhost:5432/growthsathi

# Browser and API origins. Add production origins explicitly at deployment time.
FRONTEND_URL=http://localhost:5173
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Reserved for later phases. Never commit actual credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
JWT_SECRET=
MEDIA_STORAGE_CONFIG=

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
