# Runtime selection
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
# Production must explicitly set false. Production startup rejects defaults/placeholders.
# Behind a trusted proxy that strips/replaces X-Forwarded-Proto and X-Forwarded-For:
DJANGO_TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=0

# PostgreSQL timestamps are stored in UTC.
DATABASE_URL=postgresql://growthsathi:growthsathi@localhost:5432/growthsathi
# Deployed PostgreSQL URL must include ?sslmode=require (prefer verify-full with provider CA).

# Browser and API origins. Add production origins explicitly at deployment time.
FRONTEND_URL=http://localhost:5173
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Phase 1 Google authentication. The backend and frontend values must identify the same
# Google OAuth 2.0 Web application. No Google client secret is used by this ID-token flow.
GOOGLE_CLIENT_ID=
JWT_SECRET=replace-with-an-independent-random-value-at-least-50-characters-long
AUTH_ACCESS_TOKEN_MINUTES=5
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_REFRESH_COOKIE_NAME=growthsathi_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_DOMAIN=

# Phase 3 sandbox only. RAZORPAY_KEY_ID must begin with rzp_test_.
# Configure automatic capture and payment.captured/payment.failed webhooks in Test Mode.
# Never put either secret in VITE_* variables. Live keys are rejected by the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Not implemented: leave empty. Question images use externally managed HTTPS URLs.
# Production refuses local media uploads; do not rely on an ephemeral filesystem.
MEDIA_STORAGE_CONFIG=

# Initial backend sizing; validate on staging with the expected exam burst.
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
LOG_LEVEL=INFO

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
# No VITE_RAZORPAY_KEY_ID: checkout gets its authoritative public key from the backend.
# Only these two VITE_* names are allowed. Production build requires real HTTPS/API config.
